# ========================================================
# Tattva AI - Environment Configuration
# ========================================================

# [REQUIRED FOR LIVE FACT CHECKING]
# Google Gemini API Key (used for claim extraction, multimodal OCR/audio fallback, and verdict synthesis)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily Search API Key (used for real-time evidence retrieval across news and official records)
# Obtain from: https://tavily.com
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# [OPTIONAL / ADVANCED INTEGRATIONS]
# WhatsApp Cloud API credentials (only needed for WhatsApp Bot mode)
WHATSAPP_ACCESS_TOKEN=your_whatsapp_token_here
VERIFY_TOKEN=your_custom_verify_token_here
PHONE_NUMBER_ID=your_phone_number_id_here

# Firebase Firestore / Storage credentials (only needed for optional cloud audit logging)
FIREBASE_STORAGE_BUCKET=tattva-ai.firebasestorage.app
# FIREBASE_KEY_PATH=service_account.json

# Server Settings
USE_LLM=True
PORT=8000
